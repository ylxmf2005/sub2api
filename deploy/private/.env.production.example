# =============================================================================
# Sub2API Production Environment Configuration Template
# =============================================================================
# This template contains all required and recommended environment variables
# for a production deployment of the Sub2API private fork.
#
# IMPORTANT: 
#   1. Copy this file to the server as `.env`.
#   2. Fill in the required secrets (JWT_SECRET, TOTP_ENCRYPTION_KEY, etc.).
#   3. If migrating from an old server, YOU MUST REUSE the old secrets
#      to avoid invalidating existing user sessions and 2FA.
# =============================================================================

# -----------------------------------------------------------------------------
# Release Metadata
# -----------------------------------------------------------------------------
# The explicit image reference and release tag of the bundle being deployed.
SUB2API_IMAGE=local/sub2api-private:v0.1.115-local1
SUB2API_RELEASE_TAG=v0.1.115-local1

# -----------------------------------------------------------------------------
# Critical Secrets (REUSE THESE IF MIGRATING)
# -----------------------------------------------------------------------------
# JWT_SECRET: Secret for signing session tokens.
# Generate: openssl rand -hex 32
JWT_SECRET=YOUR_RECOVERED_OR_NEW_JWT_SECRET

# TOTP_ENCRYPTION_KEY: Key for encrypting 2FA secrets in the database.
# Generate: openssl rand -hex 32
TOTP_ENCRYPTION_KEY=YOUR_RECOVERED_OR_NEW_TOTP_ENCRYPTION_KEY

# PostgreSQL Password
POSTGRES_PASSWORD=YOUR_RECOVERED_OR_NEW_DB_PASSWORD

# Redis Password (if applicable)
REDIS_PASSWORD=

# -----------------------------------------------------------------------------
# Server Network Configuration
# -----------------------------------------------------------------------------
BIND_HOST=0.0.0.0
SERVER_PORT=8080
SERVER_MODE=release
RUN_MODE=standard
TZ=Asia/Shanghai

# -----------------------------------------------------------------------------
# Admin Account
# -----------------------------------------------------------------------------
# Email for the admin account (re-use the one from the old server)
ADMIN_EMAIL=admin@example.com
# Leave empty to keep existing password or auto-generate on fresh install
ADMIN_PASSWORD=

# -----------------------------------------------------------------------------
# Database & Redis Tuning (Production Defaults)
# -----------------------------------------------------------------------------
DATABASE_MAX_OPEN_CONNS=256
DATABASE_MAX_IDLE_CONNS=128
REDIS_POOL_SIZE=4096
REDIS_MIN_IDLE_CONNS=256

# -----------------------------------------------------------------------------
# Security & Proxy Settings
# -----------------------------------------------------------------------------
# Update proxy for accessing GitHub/Pricing (if behind a firewall)
UPDATE_PROXY_URL=

# URL Allowlist (Enable if you need to restrict upstream hosts)
SECURITY_URL_ALLOWLIST_ENABLED=false
SECURITY_URL_ALLOWLIST_ALLOW_INSECURE_HTTP=false
SECURITY_URL_ALLOWLIST_ALLOW_PRIVATE_HOSTS=false

# -----------------------------------------------------------------------------
# Built-in OAuth Secrets (Optional)
# -----------------------------------------------------------------------------
# GEMINI_CLI_OAUTH_CLIENT_SECRET=
# ANTIGRAVITY_OAUTH_CLIENT_SECRET=
