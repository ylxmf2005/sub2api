# Required private overlay values
SUB2API_IMAGE=local/sub2api-private:replace-me
SUB2API_RELEASE_TAG=replace-me

# Carry these forward from the old deployment whenever they already exist.
POSTGRES_PASSWORD=
REDIS_PASSWORD=
JWT_SECRET=
TOTP_ENCRYPTION_KEY=
ADMIN_EMAIL=admin@sub2api.local
ADMIN_PASSWORD=

# Optional runtime settings that may already exist on the old server.
TZ=Asia/Shanghai
GEMINI_OAUTH_CLIENT_ID=
GEMINI_OAUTH_CLIENT_SECRET=
GEMINI_CLI_OAUTH_CLIENT_SECRET=
ANTIGRAVITY_OAUTH_CLIENT_SECRET=
SECURITY_URL_ALLOWLIST_ENABLED=false
SECURITY_URL_ALLOWLIST_ALLOW_PRIVATE_HOSTS=false
SECURITY_URL_ALLOWLIST_UPSTREAM_HOSTS=
UPDATE_PROXY_URL=
